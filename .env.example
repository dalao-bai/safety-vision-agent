# General
APP_ENV=development
APP_NAME=safety-vision-agent

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///runtime/safety_vision_agent.sqlite3
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Conversation brain LLM API
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=

# Fine-tuned VLM API
VLM_API_BASE_URL=
VLM_API_KEY=
VLM_MODEL_NAME=
VLM_TIMEOUT_SECONDS=120

# YOLO detection API
YOLO_API_BASE_URL=
YOLO_API_KEY=
YOLO_TIMEOUT_SECONDS=60
YOLO_CONFIDENCE_THRESHOLD=0.25

# Rules
RULE_BLOCKS_PATH=configs/rules/four_openings_edges_rule_blocks.example.json

# File storage
UPLOAD_DIR=./runtime/uploads
OUTPUT_DIR=./runtime/outputs
REPORT_DIR=./runtime/reports
MAX_UPLOAD_SIZE_MB=20
