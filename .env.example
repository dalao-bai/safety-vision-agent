# OpenAI-compatible Responses API configuration (required)
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here

# Model roles (required)
VLM_MODEL=gpt-4o
AGENT_MODEL=gpt-4o

# Auth: secret for signing JWTs (required - use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Auth knobs (optional - shown with defaults)
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440

# Regulation library semantic search (optional - reuses the endpoint above)
# EMBEDDING_MODEL=text-embedding-3-small
# CHROMA_DIR=runtime/chroma
# REGULATION_DIR=runtime/regulations
# MAX_REGULATION_BYTES=20971520

# Local runtime (optional - shown with defaults)
# DATABASE_PATH=runtime/agent.db
# UPLOAD_DIR=runtime/uploads
# MAX_IMAGE_BYTES=10485760
# MAX_TOOL_ITERATIONS=5
# ANNOTATION_DB_PATH=runtime/annotation.db
# REPORT_DIR=runtime/reports
